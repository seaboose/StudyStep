{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": [
    "app/**/*.tsx",
    "local/**/*.ts",
    "local/**/*.tsx",
    "lib/**/*.ts",
    "vite.local.config.ts"
  ],
  "exclude": ["node_modules", "desktop"]
}
