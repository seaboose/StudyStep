{
  "name": "studystep",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A local desktop study companion for source-linked practice, review, and focus.",
  "author": "Sebastian Marquez",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-core.mjs && node --test tests/local.test.mjs tests/focus.test.mjs tests/review.test.mjs tests/improvements.test.mjs tests/refinement.test.mjs",
    "start": "node scripts/start-local.mjs --open",
    "desktop": "node desktop/start.mjs",
    "desktop:package": "node desktop/package-windows.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "packageManager": "pnpm@11.25.0"
}
